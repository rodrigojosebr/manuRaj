{
  "name": "@manu-raj/source",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "next dev apps/pitlane -p 3000",
    "dev:pitlane": "next dev apps/pitlane -p 3000",
    "dev:torque": "next dev apps/torque -p 3001",
    "dev:showroom": "next dev apps/showroom -p 3002",
    "dev:all": "next dev apps/pitlane -p 3000 & next dev apps/torque -p 3001 & next dev apps/showroom -p 3002 & wait",
    "dev:apps": "next dev apps/pitlane -p 3000 & next dev apps/torque -p 3001 & wait",
    "build": "next build apps/pitlane",
    "build:pitlane": "next build apps/pitlane",
    "build:torque": "next build apps/torque",
    "build:showroom": "next build apps/showroom",
    "build:all": "next build apps/pitlane && next build apps/torque && next build apps/showroom",
    "start": "next start apps/pitlane -p 3000",
    "start:torque": "next start apps/torque -p 3001",
    "start:showroom": "next start apps/showroom -p 3002",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck:pitlane && npm run typecheck:torque && npm run typecheck:showroom",
    "typecheck:pitlane": "tsc --noEmit -p apps/pitlane/tsconfig.json",
    "typecheck:torque": "tsc --noEmit -p apps/torque/tsconfig.json",
    "typecheck:showroom": "tsc --noEmit -p apps/showroom/tsconfig.json",
    "panda": "panda --cwd apps/pitlane",
    "panda:codegen": "panda codegen --cwd apps/pitlane",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:seed": "npx tsx scripts/seed.ts",
    "db:check": "npx tsx scripts/check-db.ts",
    "prepare": "panda codegen --cwd apps/pitlane"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "devDependencies": {
    "@pandacss/dev": "^1.8.1",
    "@types/node": "^22.19.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "@aws-sdk/client-s3": "^3.980.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "bcryptjs": "^3.0.3",
    "mongoose": "^9.1.5",
    "next": "^16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "swagger-ui-react": "^5.31.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}
